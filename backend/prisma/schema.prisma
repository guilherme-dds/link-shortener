generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String
  links    Link[]
}

model Link {
  id          Int    @id @default(autoincrement())
  originalUrl String
  shortUrl    String @unique
  userId      String
  user        User   @relation(fields: [userId], references: [id])
}
